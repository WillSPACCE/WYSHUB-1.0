<UserControl x:Class="SystemWM.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Firewall" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}"/>
                <TextBlock Text="Gerenciamento do Firewall do Windows" Style="{StaticResource LabelSecundario}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="⟳ Atualizar lista" Style="{StaticResource BotaoSecundario}" Click="BtnAtualizar_Click"/>
        </Grid>

        <StackPanel DockPanel.Dock="Top">
            <!-- Status geral -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Status do Firewall" Style="{StaticResource TituloCard}"/>
                        <TextBlock x:Name="TxtStatusFirewall" Text="Verificando..." Margin="0,6,0,0" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnAtivar" Content="Ativar Firewall" Style="{StaticResource BotaoPrimario}" Margin="0,0,8,0" Click="BtnAtivar_Click"/>
                        <Button x:Name="BtnDesativar" Content="Desativar Firewall" Style="{StaticResource BotaoSecundario}" Click="BtnDesativar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nova regra rápida -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Liberar / Bloquear porta" Style="{StaticResource TituloCard}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox x:Name="TxtNomeRegra" Width="180" Margin="0,0,8,0" ToolTip="Nome da regra"/>
                        <TextBox x:Name="TxtPorta" Width="80" Margin="0,0,8,0" ToolTip="Porta"/>
                        <ComboBox x:Name="CmbProtocolo" Width="90" Margin="0,0,8,0" SelectedIndex="0">
                            <ComboBoxItem Content="TCP"/>
                            <ComboBoxItem Content="UDP"/>
                        </ComboBox>
                        <ComboBox x:Name="CmbAcao" Width="110" Margin="0,0,8,0" SelectedIndex="0">
                            <ComboBoxItem Content="Permitir"/>
                            <ComboBoxItem Content="Bloquear"/>
                        </ComboBox>
                        <Button Content="Criar regra" Style="{StaticResource BotaoPrimario}" Click="BtnCriarRegra_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Lista de regras -->
        <Border Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Regras configuradas" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListaRegras">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Habilitada, Mode=TwoWay}" Checked="RegraCheck_Changed" Unchecked="RegraCheck_Changed" Tag="{Binding}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Nome}" Foreground="{StaticResource TextoPrimario}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Direcao}" Foreground="{StaticResource TextoSecundario}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Protocolo}" Foreground="{StaticResource TextoSecundario}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Acao}" Foreground="{StaticResource TextoSecundario}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
