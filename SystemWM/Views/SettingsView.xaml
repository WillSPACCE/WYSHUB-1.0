<UserControl x:Class="SystemWM.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Configurações" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}"/>
            <TextBlock Text="Configuração de envio de e-mail (Resend) e preferências" Style="{StaticResource LabelSecundario}"/>
        </StackPanel>

        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Integração com Resend (envio de e-mail)" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>

                    <TextBlock Text="API Key do Resend" Style="{StaticResource LabelSecundario}"/>
                    <PasswordBox x:Name="TxtApiKey" Margin="0,4,0,10"/>

                    <TextBlock Text="Remetente (ex: SystemWM &lt;relatorios@seudominio.com&gt;)" Style="{StaticResource LabelSecundario}"/>
                    <TextBox x:Name="TxtRemetente" Margin="0,4,0,10"/>

                    <TextBlock Text="E-mail de destino padrão (opcional)" Style="{StaticResource LabelSecundario}"/>
                    <TextBox x:Name="TxtDestinoPadrao" Margin="0,4,0,10"/>

                    <TextBlock Text="Seu nome (técnico responsável)" Style="{StaticResource LabelSecundario}"/>
                    <TextBox x:Name="TxtNomeTecnico" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Button x:Name="BtnSalvar" Content="💾 Salvar configurações" Style="{StaticResource BotaoPrimario}" HorizontalAlignment="Left" Click="BtnSalvar_Click"/>
            <TextBlock x:Name="TxtStatus" Style="{StaticResource LabelSecundario}" Margin="0,10,0,0"/>
        </StackPanel>
    </DockPanel>
</UserControl>
