<UserControl x:Class="SystemWM.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Hardware" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}"/>
                <TextBlock Text="Detalhes completos dos componentes" Style="{StaticResource LabelSecundario}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="⟳ Atualizar" Style="{StaticResource BotaoSecundario}" Click="BtnAtualizar_Click"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TxtCarregando" Text="Coletando dados..." Foreground="{StaticResource TextoSecundario}"/>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Processador (CPU)" Style="{StaticResource TituloCard}"/>
                        <ItemsControl x:Name="ListaCpu" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Memória RAM" Style="{StaticResource TituloCard}"/>
                        <ItemsControl x:Name="ListaRam" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Armazenamento" Style="{StaticResource TituloCard}"/>
                        <ItemsControl x:Name="ListaDiscos" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CardGpu" Style="{StaticResource CardStyle}" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Placa de Vídeo (GPU)" Style="{StaticResource TituloCard}"/>
                        <ItemsControl x:Name="ListaGpu" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
