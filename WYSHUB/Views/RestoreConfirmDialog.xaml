<Window x:Class="SystemWM.Views.RestoreConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar restauração"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <StackPanel Margin="20" Width="420">
        <TextBlock Text="Restaurar todos os arquivos do backup para suas pastas originais?" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12"/>
        <TextBlock Text="Esta ação moverá os arquivos de volta para as pastas de origem e não poderá ser desfeita pelo app." Style="{StaticResource LabelSecundario}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <Button x:Name="BtnRestaurar" Content="Restaurar" Style="{StaticResource BotaoPrimario}" Click="BtnRestaurar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
