<UserControl x:Class="SystemWM.Views.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Utilidades" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextoPrimario}"/>
            <TextBlock Text="Aqui você poderá adicionar novas ferramentas úteis ao programa, sem interferir nos relatórios." Style="{StaticResource LabelSecundario}"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,32" MaxWidth="720">
            <Border Style="{StaticResource CardStyle}" Width="720" Height="250" Margin="0,0,0,24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock Text="Compartilhar pasta na rede" FontWeight="SemiBold" Foreground="{StaticResource TextoPrimario}" TextAlignment="Center" TextWrapping="Wrap" FontSize="18" Margin="0,0,0,12"/>
                    <TextBlock Text="Selecione uma pasta e compartilhe-a para todos os usuários da rede." Style="{StaticResource LabelSecundario}" TextWrapping="Wrap" Margin="0,0,0,16" TextAlignment="Center" FontSize="14"/>
                    <Button x:Name="BtnSelecionarCompartilhar" Content="Escolher pasta e compartilhar" Style="{StaticResource BotaoPrimario}" Width="320" Height="38" Click="BtnSelecionarCompartilhar_Click" Margin="0,0,0,16"/>
                    <TextBlock x:Name="TxtPastaSelecionada" Text="Nenhuma pasta selecionada." Style="{StaticResource LabelSecundario}" TextWrapping="Wrap" Margin="0,0,0,10" TextAlignment="Center" FontSize="13"/>
                    <TextBlock x:Name="TxtStatusCompartilhamento" Text="" Style="{StaticResource LabelSecundario}" TextWrapping="Wrap" Margin="0,0,0,0" TextAlignment="Center" Foreground="{StaticResource TextoPrimario}" FontSize="13"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
